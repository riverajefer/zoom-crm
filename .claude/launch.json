{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "cwd": "frontend",
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:dev"
      ],
      "cwd": "backend",
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend-3100",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=3100 CORS_ORIGINS=http://localhost:5175 npm run start:dev"
      ],
      "cwd": "backend",
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "frontend-5175",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "VITE_API_URL=http://localhost:3100/api/v1 npm run dev -- --port 5175 --strictPort"
      ],
      "cwd": "frontend",
      "port": 5175,
      "autoPort": false
    }
  ]
}
