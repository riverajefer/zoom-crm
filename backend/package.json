{
  "name": "nestjs-auth-rbac",
  "version": "1.0.0",
  "description": "NestJS API with JWT authentication and RBAC (Role-Based Access Control)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:staging": "NODE_ENV=staging node dist/main",
    "start:prod": "NODE_ENV=production node dist/main",
    "env:info": "ts-node scripts/env-info.ts",
    "prisma:reset": "prisma migrate reset --force && npm run prisma:seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "prisma:migrate:resolve:applied": "sh -c 'prisma migrate resolve --applied \"$MIGRATION_NAME\"'",
    "prisma:migrate:resolve:rolledback": "sh -c 'prisma migrate resolve --rolled-back \"$MIGRATION_NAME\"'",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:ap": "ts-node prisma/seed-accounts-payable.ts",
    "prisma:seed:exports": "ts-node prisma/seed-export-permissions.ts",
    "prisma:seed:prospects": "ts-node prisma/seed-prospect-permissions.ts",
    "prisma:import:high": "ts-node prisma/import-high-catalog.ts",
    "prisma:sync:permissions": "ts-node prisma/sync-permissions.ts",
    "prisma:backfill:credit-balance": "ts-node prisma/backfill-credit-balance-applications.ts",
    "prisma:backfill:refunded-amount": "ts-node --transpile-only prisma/backfill-refunded-amount.ts",
    "prisma:audit:credit-balance": "ts-node --transpile-only prisma/audit-credit-balance-usage.ts",
    "prisma:void:credit-balance-movements": "ts-node --transpile-only prisma/void-credit-balance-cash-movements.ts",
    "db:reset": "prisma migrate reset --force && npm run prisma:seed",
    "db:setup": "prisma migrate dev --name init && npm run prisma:seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testPathIgnorePatterns": [
      "<rootDir>/generated/",
      "<rootDir>/coverage-phase1/"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/generated/",
      "<rootDir>/coverage-phase1/",
      "<rootDir>/config/",
      "<rootDir>/database/seeds/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/main.ts",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  },
  "keywords": [
    "nestjs",
    "prisma",
    "authentication",
    "jwt",
    "rbac",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.989.0",
    "@aws-sdk/s3-request-presigner": "^3.989.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.18",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.2.0",
    "@prisma/config": "^7.2.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cpx": "^1.5.0",
    "cron": "4.3.5",
    "dotenv": "^17.2.3",
    "nestjs-pino": "^4.6.1",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.18.0",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.8",
    "@types/node-fetch": "^2.6.13",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ws": "8.21.3",
    "engine.io": "6.6.10",
    "socket.io-parser": "4.2.7",
    "fast-xml-parser": "5.11.1"
  }
}
