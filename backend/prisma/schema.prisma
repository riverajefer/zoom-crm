  updatedAt    DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("attendance_records")
}

model ActivityHeartbeat {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  timestamp DateTime @default(now())
  endpoint  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("activity_heartbeats")
}

// =============================================================================
// MÓDULO DE INVENTARIO - MOVIMIENTOS DE INSUMOS
// =============================================================================

enum InventoryMovementType {
  ENTRY // Entrada de stock (compra, recepción)
  EXIT // Salida de stock (consumo en OT - automático)
  ADJUSTMENT // Ajuste manual (conteo físico, corrección)
  RETURN // Devolución al stock desde producción
  INITIAL // Carga inicial de stock
}

model InventoryMovement {
  id            String                @id @default(uuid())
  supplyId      String                @map("supply_id")
  type          InventoryMovementType
  quantity      Decimal // Siempre positivo; la dirección la determina el tipo
  unitCost      Decimal?              @map("unit_cost") // Costo unitario en el momento del movimiento
  previousStock Decimal               @map("previous_stock")
  newStock      Decimal               @map("new_stock")
  referenceType String?               @map("reference_type") // "WORK_ORDER", "MANUAL", "INITIAL"
  referenceId   String?               @map("reference_id")
  reason        String? // Motivo del ajuste
  notes         String?
  performedById String                @map("performed_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  supply      Supply @relation(fields: [supplyId], references: [id])
  performedBy User   @relation(fields: [performedById], references: [id])

  @@index([supplyId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// =============================================================================
// MÓDULO DE PRODUCCIÓN - PLANTILLAS Y ÓRDENES DE PRODUCCIÓN
// =============================================================================

enum ComponentPhase {
  impresion
  material
  armado
  despacho
}

enum ProductionOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

// Catálogo de tipos de paso de producción (dinámico — convention: UPPERCASE_SNAKE_CASE)
model StepDefinition {
  id          String   @id @default(uuid())
  type        String   @unique // Convention: UPPERCASE_SNAKE_CASE (e.g. PAPEL, BARNIZADO_UV)
  name        String
  description String?
  fieldSchema Json     @map("field_schema") // { fields: [{ key, label, type, stage, required, options? }] }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  templateComponentSteps TemplateComponentStep[]
  productionOrderSteps   ProductionOrderStep[]

  @@map("step_definitions")
}

// Plantilla de producto (Cuaderno, Carpeta, Revista, Talonario, etc.)
model ProductTemplate {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  components       TemplateComponent[]
  productionOrders ProductionOrder[]

  @@map("product_templates")
}

// Componente dentro de una plantilla (Portadas, Hojas internas, Armado, Empaque, etc.)
model TemplateComponent {
  id         String         @id @default(uuid())
  templateId String         @map("template_id")
  name       String
  order      Int
  isRequired Boolean        @default(true) @map("is_required")
  phase      ComponentPhase
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  template ProductTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  steps    TemplateComponentStep[]

  @@index([templateId])
  @@map("template_components")
}

// Paso dentro de un componente de plantilla (con posibilidad de fieldOverrides)
model TemplateComponentStep {
  id               String   @id @default(uuid())
  componentId      String   @map("component_id")
  stepDefinitionId String   @map("step_definition_id")
  order            Int
  isRequired       Boolean  @default(true) @map("is_required")
  fieldOverrides   Json?    @map("field_overrides") // { remove: [...], add: [...], override: [...] }
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  component      TemplateComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  stepDefinition StepDefinition    @relation(fields: [stepDefinitionId], references: [id])

  @@index([componentId])
  @@map("template_component_steps")
}

// Orden de producción instanciada desde una plantilla (1:N con WorkOrder)
model ProductionOrder {
  id          String                @id @default(uuid())
  oprodNumber String                @unique @map("oprod_number") // "OPROD-2026-0001"
  templateId  String                @map("template_id")
  workOrderId String                @map("work_order_id")
  status      ProductionOrderStatus @default(PENDING)
  notes       String?
  createdById String                @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  template   ProductTemplate            @relation(fields: [templateId], references: [id])
  workOrder  WorkOrder                  @relation(fields: [workOrderId], references: [id])
  createdBy  User                       @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  components ProductionOrderComponent[]

  @@index([workOrderId])
  @@index([status])
  @@index([createdById])
  @@map("production_orders")
}

// Copia instanciada de cada TemplateComponent para una OT específica
model ProductionOrderComponent {
  id                String         @id @default(uuid())
  productionOrderId String         @map("production_order_id")
  name              String
  order             Int
  phase             ComponentPhase
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  productionOrder ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  steps           ProductionOrderStep[]

  @@index([productionOrderId])
  @@map("production_order_components")
}

// Copia instanciada de cada paso con su estado y valores llenados
model ProductionOrderStep {
  id               String               @id @default(uuid())
  componentId      String               @map("component_id")
  stepDefinitionId String               @map("step_definition_id")
  order            Int
  status           ProductionStepStatus @default(PENDING)
  fieldValues      Json                 @default("{}") @map("field_values") // { specification: {}, execution: {} }
  completedAt      DateTime?            @map("completed_at")
  completedById    String?              @map("completed_by_id")
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  component      ProductionOrderComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  stepDefinition StepDefinition           @relation(fields: [stepDefinitionId], references: [id])
  completedBy    User?                    @relation("ProductionStepCompletedBy", fields: [completedById], references: [id])

  @@index([componentId])
  @@index([status])
  @@map("production_order_steps")
}

// =============================================================================
// MÓDULO DE COMENTARIOS — Comentarios Polimórficos
// =============================================================================

enum CommentEntityType {
  QUOTE
  ORDER
  WORK_ORDER
}

model Comment {
  id         String            @id @default(uuid())
  content    String
  entityType CommentEntityType @map("entity_type")
  entityId   String            @map("entity_id")
  authorId   String            @map("author_id")
  parentId   String?           @map("parent_id")
  deletedAt  DateTime?         @map("deleted_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  author  User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([entityType, entityId])
  @@index([parentId])
  @@map("comments")
}

// =============================================================================
// MÓDULO DE CAJA REGISTRADORA (POS)
// =============================================================================

model CashRegister {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             String            @id @default(uuid())
  cashRegisterId String            @map("cash_register_id")
  openedById     String            @map("opened_by_id")
  closedById     String?           @map("closed_by_id")
  status         CashSessionStatus @default(OPEN)
  openingAmount  Decimal           @map("opening_amount")
  closingAmount  Decimal?          @map("closing_amount")
  systemBalance  Decimal?          @map("system_balance")
  discrepancy    Decimal?
  notes          String?
  openedAt       DateTime          @default(now()) @map("opened_at")
  closedAt       DateTime?         @map("closed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  cashRegister  CashRegister            @relation(fields: [cashRegisterId], references: [id])
  openedBy      User                    @relation("OpenedCashSessions", fields: [openedById], references: [id])
  closedBy      User?                   @relation("ClosedCashSessions", fields: [closedById], references: [id])
  denominations CashDenominationCount[]
  movements     CashMovement[]

  @@index([cashRegisterId, status])
  @@index([openedById])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashDenominationCount {
  id            String                @id @default(uuid())
  cashSessionId String                @map("cash_session_id")
  countType     DenominationCountType @map("count_type")
  denomType     DenominationType      @map("denom_type")
  denomination  Int
  quantity      Int
  subtotal      Decimal

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@unique([cashSessionId, countType, denomination])
  @@index([cashSessionId, countType])
  @@map("cash_denomination_counts")
}

model CashMovement {
  id                String           @id @default(uuid())
  cashSessionId     String           @map("cash_session_id")
  receiptNumber     String           @unique @map("receipt_number")
  movementType      CashMovementType @map("movement_type")
  paymentMethod     PaymentMethod    @default(CASH) @map("payment_method")
  amount            Decimal
  description       String
  referenceType     String?          @map("reference_type")
  referenceId       String?          @map("reference_id")
  isVoided          Boolean          @default(false) @map("is_voided")
  voidedById        String?          @map("voided_by_id")
  voidedAt          DateTime?        @map("voided_at")
  voidReason        String?          @map("void_reason")
  counterMovementId String?          @unique @map("counter_movement_id")
  performedById     String           @map("performed_by_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  cashSession           CashSession               @relation(fields: [cashSessionId], references: [id])
  performedBy           User                      @relation("PerformedCashMovements", fields: [performedById], references: [id])
  voidedBy              User?                     @relation("VoidedCashMovements", fields: [voidedById], references: [id])
  counterMovement       CashMovement?             @relation("CounterMovement", fields: [counterMovementId], references: [id])
  originalMovement      CashMovement?             @relation("CounterMovement")
  linkedPayment         Payment?
  voidRequests          CashMovementVoidRequest[]
  refundRequest         RefundRequest?
  accountPayablePayment AccountPayablePayment?

  @@index([cashSessionId])
  @@index([performedById])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("cash_movements")
}

model CashMovementVoidRequest {
  id             String            @id @default(uuid())
  // Uno de los dos, nunca ambos vacíos.
  //
  // Un tercio de los pagos recientes no tiene movimiento de caja (se registran
  // fuera del horario de caja o salen de saldo a favor). Si la solicitud solo
  // pudiera apuntar a un movimiento, el comercial no podría pedir la anulación
  // justo de esos, que son los que más se equivocan.
  cashMovementId String?           @map("cash_movement_id")
  paymentId      String?           @map("payment_id")
  requestedById  String            @map("requested_by_id")
  voidReason     String            @map("void_reason")
  status         EditRequestStatus @default(PENDING)

  // Aprobación/rechazo
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: Cascade)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("RequestedVoidRequests", fields: [requestedById], references: [id])
  reviewedBy   User?         @relation("ReviewedVoidRequests", fields: [reviewedById], references: [id])

  @@index([cashMovementId])
  @@index([paymentId])
  @@index([requestedById])
  @@index([status])
  @@map("cash_movement_void_requests")
}

// =============================================================================
// MÓDULO DE SOLICITUDES DE DEVOLUCIÓN DE DINERO AL CLIENTE
// =============================================================================

model RefundRequest {
  id                     String            @id @default(uuid())
  orderId                String            @map("order_id")
  // Dinero que sale de la caja hacia el cliente.
  refundAmount           Decimal           @map("refund_amount")
  // Valor de la venta que se anula. Cero = devolución de saldo a favor (el
  // cliente pagó de más y esa plata nunca fue una venta). Mayor que cero =
  // reversión: el trabajo no se entregó o no cumplió. No tiene por qué ser
  // igual a `refundAmount`: una OP de $500.000 con $200.000 abonados que se cae
  // entera anula $500.000 de venta y devuelve $200.000 de dinero.
  reversedAmount         Decimal           @default(0) @map("reversed_amount")
  refundReason           RefundReason      @default(CREDIT_BALANCE) @map("refund_reason")
  paymentMethod          PaymentMethod     @map("payment_method")
  bankEntity             String?           @map("bank_entity") // Entidad bancaria de origen (solo transferencias)
  // Comprobante de la transferencia (id de UploadedFile). Igual que en Payment,
  // se guarda como texto suelto y no como relación.
  //
  // Son dos porque son dos momentos distintos: el de la solicitud lo adjunta
  // quien pide la devolución cuando la transferencia ya se hizo, y el de la
  // ejecución lo adjunta Caja al hacerla. Guardarlos en un solo campo obligaría
  // a que el segundo borrara al primero.
  receiptFileId          String?           @map("receipt_file_id")
  executionReceiptFileId String?           @map("execution_receipt_file_id")
  observation            String
  status                 EditRequestStatus @default(PENDING)

  // Solicitante
  requestedById String   @map("requested_by_id")
  requestedAt   DateTime @default(now()) @map("requested_at")

  // Revisión
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")

  // Ejecución: gerencia autoriza, Caja paga. Mientras `executedAt` sea null la
  // solicitud está APROBADA pero el dinero no ha salido, que es justo lo que
  // permite aprobar por WhatsApp con la caja cerrada.
  executedAt     DateTime? @map("executed_at")
  executedById   String?   @map("executed_by_id")
  cashMovementId String?   @unique @map("cash_movement_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("RequestedRefundRequests", fields: [requestedById], references: [id])
  reviewedBy   User?         @relation("ReviewedRefundRequests", fields: [reviewedById], references: [id])
  executedBy   User?         @relation("ExecutedRefundRequests", fields: [executedById], references: [id])
  cashMovement CashMovement? @relation(fields: [cashMovementId], references: [id])

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  // Los creó la migración y no estaban declarados aquí.
  @@index([executedById])
  @@index([receiptFileId])
  @@index([executionReceiptFileId])
  @@map("refund_requests")
}

// =============================================================================
// MÓDULO DE CUENTAS POR PAGAR
// =============================================================================

enum AccountPayableStatus {
  PENDING
  ADMIN_AUTHORIZED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum RecurringFrequency {
  BIWEEKLY
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

model AccountPayable {
  id                   String               @id @default(uuid())
  apNumber             String               @unique @map("ap_number")
  expenseTypeId        String               @map("expense_type_id")
  expenseSubcategoryId String               @map("expense_subcategory_id")
  status               AccountPayableStatus @default(PENDING)
  description          String
  observations         String?
  // Base gravable capturada en el formulario. `totalAmount` es lo que hay que
  // pagar (base + IVA - retenciones); guardar la base evita reconstruirla
  // dividiendo el total, cuenta que deja de cuadrar cuando hay retenciones.
  subtotalAmount       Decimal              @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  totalAmount          Decimal              @map("total_amount") @db.Decimal(12, 2)
  paidAmount           Decimal              @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balance              Decimal              @map("balance") @db.Decimal(12, 2)
  applyIva             Boolean              @default(false) @map("apply_iva")
  ivaRate              Decimal              @default(0.19) @map("iva_rate")
  // Retenciones practicadas al proveedor (ver ExpenseOrder).
  retefuenteRate       Decimal              @default(0) @map("retefuente_rate")
  reteICARate          Decimal              @default(0) @map("rete_ica_rate")
  reteIVARate          Decimal              @default(0) @map("rete_iva_rate")
  dueDate              DateTime             @map("due_date")
  isRecurring          Boolean              @default(false) @map("is_recurring")
  recurringDay         Int?                 @map("recurring_day")
  recurringFrequency   RecurringFrequency?  @map("recurring_frequency")

  supplierId     String? @map("supplier_id")
  expenseOrderId String? @unique @map("expense_order_id")

  // Anticipo de nómina: usuario beneficiario y periodo de nómina en curso al que
  // se vincula (solo cuando el tipo es "Personal" y la subcategoría "Anticipos").
  beneficiaryUserId String? @map("beneficiary_user_id")
  payrollPeriodId   String? @map("payroll_period_id")

  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  cancelledAt    DateTime? @map("cancelled_at")
  cancelledById  String?   @map("cancelled_by_id")
  cancelReason   String?   @map("cancel_reason")
  authorizedById String?   @map("authorized_by_id")
  authorizedAt   DateTime? @map("authorized_at")

  expenseType         ExpenseType                        @relation(fields: [expenseTypeId], references: [id])
  expenseSubcategory  ExpenseSubcategory                 @relation(fields: [expenseSubcategoryId], references: [id])
  supplier            Supplier?                          @relation(fields: [supplierId], references: [id])
  expenseOrder        ExpenseOrder?                      @relation(fields: [expenseOrderId], references: [id])
  createdBy           User                               @relation("AccountPayableCreatedBy", fields: [createdById], references: [id])
  cancelledBy         User?                              @relation("AccountPayableCancelledBy", fields: [cancelledById], references: [id])
  authorizedBy        User?                              @relation("AccountPayableAuthorizedBy", fields: [authorizedById], references: [id])
  beneficiaryUser     User?                              @relation("AccountPayableBeneficiary", fields: [beneficiaryUserId], references: [id])
  payrollPeriod       PayrollPeriod?                     @relation(fields: [payrollPeriodId], references: [id])
  payments            AccountPayablePayment[]
  attachments         AccountPayableAttachment[]
  installments        AccountPayableInstallment[]
  authRequests        AccountPayableAuthRequest[]
  paymentAuthRequests AccountPayablePaymentAuthRequest[]

  @@index([status])
  @@index([dueDate])
  @@index([supplierId])
  @@index([createdById])
  @@index([createdAt])
  @@index([beneficiaryUserId])
  @@index([payrollPeriodId])
  @@map("accounts_payable")
}

model AccountPayablePayment {
  id               String        @id @default(uuid())
  accountPayableId String        @map("account_payable_id")
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(CASH) @map("payment_method")
  reference        String?
  notes            String?
  bankEntity       String?       @map("bank_entity") // Entidad bancaria de origen (solo transferencias)
  receiptFileId    String?       @map("receipt_file_id")
  // Segundo comprobante opcional: un pago suele soportarse con dos soportes
  // (p. ej. la transferencia y la factura sellada) y antes solo cabía uno.
  receiptFileId2   String?       @map("receipt_file_id_2")
  cashMovementId   String?       @unique @map("cash_movement_id")

  registeredById       String   @map("registered_by_id")
  paymentDate          DateTime @map("payment_date")
  paymentAuthRequestId String?  @unique @map("payment_auth_request_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  accountPayable     AccountPayable                    @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  cashMovement       CashMovement?                     @relation(fields: [cashMovementId], references: [id])
  registeredBy       User                              @relation("AccountPayablePaymentRegisteredBy", fields: [registeredById], references: [id])
  paymentAuthRequest AccountPayablePaymentAuthRequest? @relation(fields: [paymentAuthRequestId], references: [id])
  isReversed         Boolean                           @default(false) @map("is_reversed")
  reversedAt         DateTime?                         @map("reversed_at")

  @@index([accountPayableId])
  @@index([paymentDate])
  @@map("account_payable_payments")
}

model AccountPayableAttachment {
  id               String   @id @default(uuid())
  accountPayableId String   @map("account_payable_id")
  fileUrl          String   @map("file_url")
  fileName         String   @map("file_name")
  fileType         String?  @map("file_type")
  uploadedById     String   @map("uploaded_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("AccountPayableAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([accountPayableId])
  @@map("account_payable_attachments")
}

model AccountPayableInstallment {
  id                String    @id @default(uuid())
  accountPayableId  String    @map("account_payable_id")
  installmentNumber Int       @map("installment_number")
  amount            Decimal   @db.Decimal(12, 2)
  dueDate           DateTime  @map("due_date")
  isPaid            Boolean   @default(false) @map("is_paid")
  paidAt            DateTime? @map("paid_at")
  paidById          String?   @map("paid_by_id")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  paidBy         User?          @relation("InstallmentPaidBy", fields: [paidById], references: [id])

  @@index([accountPayableId])
  @@map("account_payable_installments")
}

// =============================================================================
// MÓDULO DE AUTORIZACIÓN DE PAGOS DE CUENTAS POR PAGAR (doble firma)
// =============================================================================

model AccountPayablePaymentAuthRequest {
  id               String @id @default(uuid())
  accountPayableId String @map("account_payable_id")
  requestedById    String @map("requested_by_id")

  // Datos del pago solicitado (capturados al crear la solicitud)
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  paymentDate    DateTime      @map("payment_date")
  reference      String?
  notes          String?
  bankEntity     String?       @map("bank_entity") // Entidad bancaria de origen (solo transferencias)
  receiptFileId  String?       @map("receipt_file_id")
  // Segundo comprobante opcional (ver AccountPayablePayment.receiptFileId2)
  receiptFileId2 String?       @map("receipt_file_id_2")
  reason         String? // Justificación del pago

  status ApPaymentAuthRequestStatus @default(PENDING)

  // Paso 1: revisión de Admin
  adminReviewedById String?   @map("admin_reviewed_by_id")
  adminReviewedAt   DateTime? @map("admin_reviewed_at")
  adminNotes        String?   @map("admin_notes")

  // Paso 2: revisión de Caja
  cajaReviewedById    String?   @map("caja_reviewed_by_id")
  cajaReviewedAt      DateTime? @map("caja_reviewed_at")
  cajaRejectionReason String?   @map("caja_rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountPayable  AccountPayable                        @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  requestedBy     User                                  @relation("RequestedApPaymentAuthRequests", fields: [requestedById], references: [id])
  adminReviewedBy User?                                 @relation("AdminReviewedApPaymentAuthRequests", fields: [adminReviewedById], references: [id])
  cajaReviewedBy  User?                                 @relation("CajaReviewedApPaymentAuthRequests", fields: [cajaReviewedById], references: [id])
  createdPayment  AccountPayablePayment?
  reversalRequest AccountPayablePaymentReversalRequest?

  @@index([accountPayableId])
  @@index([requestedById])
  @@index([status])
  @@map("account_payable_payment_auth_requests")
}

// =============================================================================
// MÓDULO DE REVERSIÓN DE PAGOS DE CUENTAS POR PAGAR (doble firma inversa)
// =============================================================================

enum ApPaymentReversalStatus {
  PENDING_GERENCIA // Esperando aprobación de Gerencia (paso 1)
  PENDING_CAJA // Gerencia aprobó — esperando confirmación de Caja (paso 2)
  COMPLETED // Caja confirmó — reversión ejecutada
  REJECTED_BY_GERENCIA
  REJECTED_BY_CAJA
}

model AccountPayablePaymentReversalRequest {
  id     String @id @default(uuid())
  reason String

  status ApPaymentReversalStatus @default(PENDING_GERENCIA)

  // Paso 1: Gerencia aprueba o rechaza
  gerenciaReviewedById   String?   @map("gerencia_reviewed_by_id")
  gerenciaReviewedAt     DateTime? @map("gerencia_reviewed_at")
  gerenciaRejectionNotes String?   @map("gerencia_rejection_notes")

  // Paso 2: Caja confirma o rechaza
  cajaReviewedById   String?   @map("caja_reviewed_by_id")
  cajaReviewedAt     DateTime? @map("caja_reviewed_at")
  cajaRejectionNotes String?   @map("caja_rejection_notes")

  // Relaciones
  paymentAuthRequestId String @unique @map("payment_auth_request_id")
  requestedById        String @map("requested_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // La migración original dejó la llave foránea y el índice único con el mismo
  // nombre (PostgreSQL lo permite, Prisma no), así que la migración
  // `20260917010000_align_schema_with_migrations` los renombró a los nombres
  // que Prisma genera y aquí ya no hace falta `map:`.
  //
  // `onDelete: NoAction` es lo que creó la migración al no declarar la
  // cláusula: el usuario no se puede borrar mientras tenga solicitudes, en vez
  // de quedar en null.
  paymentAuthRequest AccountPayablePaymentAuthRequest @relation(fields: [paymentAuthRequestId], references: [id], onDelete: Cascade)
  requestedBy        User                             @relation("RequestedApPaymentReversalRequests", fields: [requestedById], references: [id], onDelete: NoAction)
  gerenciaReviewedBy User?                            @relation("GerenciaReviewedApPaymentReversalRequests", fields: [gerenciaReviewedById], references: [id], onDelete: NoAction)
  cajaReviewedBy     User?                            @relation("CajaReviewedApPaymentReversalRequests", fields: [cajaReviewedById], references: [id], onDelete: NoAction)

  @@index([status])
  @@index([requestedById])
  @@map("account_payable_payment_reversal_requests")
}

// =============================================================================
// MÓDULO DTF
// =============================================================================

enum DtfStatus {
  BORRADOR
  ENVIADA
  EN_IMPRESION
  COMPLETADA
  CONVERTIDA_EN_OP
}

model DtfRecord {
  id                 String         @id @default(uuid())
  consecutive        String         @unique
  productId          String         @map("product_id")
  clientId           String         @map("client_id")
  quantity           Decimal        @db.Decimal(12, 4)
  unitPrice          Decimal        @map("unit_price") @db.Decimal(12, 2)
  value              Decimal        @db.Decimal(12, 2)
  abono              Decimal        @default(0) @db.Decimal(12, 2) // Abono / anticipo del cliente
  abonoPaymentMethod PaymentMethod? @map("abono_payment_method") // Método de pago del abono
  abonoBankEntity    String?        @map("abono_bank_entity") // Entidad bancaria de origen del abono (solo transferencias)
  abonoNotes         String?        @map("abono_notes") // Notas del abono
  applyIva           Boolean        @default(false) @map("apply_iva") // ¿Aplica IVA (19%)? Se traslada a la OP al convertir
  status             DtfStatus      @default(BORRADOR)
  orderId            String?        @map("order_id")
  createdById        String         @map("created_by_id")
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  product       Product            @relation(fields: [productId], references: [id])
  client        Client             @relation(fields: [clientId], references: [id])
  order         Order?             @relation(fields: [orderId], references: [id])
  createdBy     User               @relation("DtfCreatedBy", fields: [createdById], references: [id])
  statusHistory DtfStatusHistory[]

  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([createdById])
  @@map("dtf_records")
}

model SalesGoal {
  id           String   @id @default(uuid())
  advisorId    String   @map("advisor_id")
  month        Int
  year         Int
  targetAmount Decimal  @map("target_amount") @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  advisor User @relation("AdvisorSalesGoals", fields: [advisorId], references: [id])

  @@unique([advisorId, month, year])
  @@map("sales_goals")
}

model DtfStatusHistory {
  id          String     @id @default(uuid())
  dtfId       String     @map("dtf_id")
  fromStatus  DtfStatus? @map("from_status")
  toStatus    DtfStatus  @map("to_status")
  changedById String     @map("changed_by_id")
  changedAt   DateTime   @default(now()) @map("changed_at")

  dtf       DtfRecord @relation(fields: [dtfId], references: [id])
  changedBy User      @relation("DtfStatusChangedBy", fields: [changedById], references: [id])

  @@index([dtfId])
  @@map("dtf_status_history")
}

// ============================================
// PIPELINE DE VENTAS (Prospectos)
// ============================================

enum ProspectStatus {
  NUEVO
  EN_SEGUIMIENTO
  COTIZADO
  CONVERTIDO
  PERDIDO
  NO_INTERESADO
}

enum ContactMedium {
  WHATSAPP
  LLAMADA
  CORREO
  PRESENCIAL
  REDES
  OTRO
}

enum ContactOutcome {
  CONTESTO
  NO_CONTESTO
  SOLICITO_COTIZACION
  NO_INTERESADO
  REPROGRAMAR
  REUNION_FISICA
  REUNION_VIRTUAL
}

/// Contacto comercial en seguimiento. Todos los datos de identificación son
/// opcionales a propósito: la vendedora a veces solo tiene el celular.
/// La regla "al menos uno de name/phone/email" se valida en el servicio.
model Prospect {
  id          String         @id @default(uuid())
  name        String?
  phone       String?
  email       String?
  observation String?
  status      ProspectStatus @default(NUEVO)

  advisorId String  @map("advisor_id")
  clientId  String? @map("client_id")
  quoteId   String? @map("quote_id")
  orderId   String? @map("order_id")

  // Denormalizado: se recalcula al crear/eliminar un contacto, en la misma
  // transacción. Permite ordenar por "días sin contactar" sin subqueries.
  lastContactAt DateTime? @map("last_contact_at")
  contactCount  Int       @default(0) @map("contact_count")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  advisor   User              @relation("ProspectAdvisor", fields: [advisorId], references: [id])
  createdBy User              @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  client    Client?           @relation(fields: [clientId], references: [id])
  quote     Quote?            @relation(fields: [quoteId], references: [id])
  order     Order?            @relation(fields: [orderId], references: [id])
  contacts  ProspectContact[]

  @@index([advisorId])
  @@index([status])
  @@index([lastContactAt])
  @@index([createdAt])
  @@map("prospects")
}

/// Cada toque comercial hecho a un prospecto. Reemplaza las columnas fijas
/// CONTACTO 1/2/3 de la hoja de cálculo: aquí no hay límite.
model ProspectContact {
  id          String          @id @default(uuid())
  prospectId  String          @map("prospect_id")
  contactDate DateTime        @map("contact_date")
  medium      ContactMedium
  outcome     ContactOutcome?
  note        String?
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  prospect  Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ProspectContactCreatedBy", fields: [createdById], references: [id])

  @@index([prospectId])
  @@index([contactDate])
  @@index([medium])
  @@map("prospect_contacts")
}
