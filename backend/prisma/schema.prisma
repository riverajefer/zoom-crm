// ============================================================
// PAYROLL MODULE
// ============================================================

enum EmployeeType {
  REGULAR // Monthly salary
  TEMPORARY // Daily rate
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ContractType {
  FIXED_TERM
  INDEFINITE
  SERVICE_CONTRACT
  INTERNSHIP
}

enum IdentificationType {
  CC // Cédula de ciudadanía
  CE // Cédula de extranjería
  TI // Tarjeta de identidad
  PA // Pasaporte
  PPT // Permiso por protección temporal
  NIT
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum PayrollPeriodType {
  BIWEEKLY
  MONTHLY
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  PAID
  IN_PROGRESS
}

model Employee {
  id              String         @id @default(uuid())
  userId          String         @unique
  cargoId         String?
  employeeType    EmployeeType   @default(REGULAR)
  monthlySalary   Decimal?       @db.Decimal(12, 2)
  dailyRate       Decimal?       @db.Decimal(12, 2)
  startDate       DateTime
  contractEndDate DateTime?
  contractType    ContractType?
  status          EmployeeStatus @default(ACTIVE)
  notes           String?

  // Identificación
  identificationType   IdentificationType?
  identificationNumber String?
  documentIssueDate    DateTime? // Fecha de expedición del documento

  // Nombres
  firstName      String?
  middleName     String?
  firstLastName  String?
  secondLastName String?

  // Datos personales
  sex       Sex?
  birthDate DateTime?

  // Contacto
  address      String?
  neighborhood String?
  phone        String?
  email        String?

  // Seguridad social
  eps         String?
  pensionFund String?

  // Contacto de emergencia
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  cargo             Cargo?             @relation(fields: [cargoId], references: [id])
  payrollItems      PayrollItem[]
  clientProfile     Client?
  payrollDeductions PayrollDeduction[]

  @@map("employees")
}

model PayrollPeriod {
  id                           String              @id @default(uuid())
  name                         String
  startDate                    DateTime
  endDate                      DateTime
  periodType                   PayrollPeriodType
  status                       PayrollPeriodStatus @default(DRAFT)
  overtimeDaytimeRate          Decimal?            @db.Decimal(10, 2)
  overtimeNighttimeRate        Decimal?            @db.Decimal(10, 2)
  overtimeDaytimeFestiveRate   Decimal?            @db.Decimal(10, 2)
  overtimeNighttimeFestiveRate Decimal?            @db.Decimal(10, 2)
  notes                        String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  payrollItems    PayrollItem[]
  advanceAccounts AccountPayable[]

  @@map("payroll_periods")
}

model PayrollItem {
  id                     String   @id @default(uuid())
  periodId               String
  employeeId             String
  daysWorked             Decimal? @db.Decimal(5, 2)
  baseSalary             Decimal  @db.Decimal(12, 2)
  overtimeDaytimeHours   Decimal? @db.Decimal(7, 2)
  overtimeNighttimeHours Decimal? @db.Decimal(7, 2)
  overtimeDaytimeValue   Decimal? @db.Decimal(12, 2)
  overtimeNighttimeValue Decimal? @db.Decimal(12, 2)
  commissions            Decimal? @db.Decimal(12, 2)
  restDayValue           Decimal? @db.Decimal(12, 2)
  transportAllowance     Decimal? @db.Decimal(12, 2)
  workdayDiscount        Decimal? @db.Decimal(12, 2)
  loans                  Decimal? @db.Decimal(12, 2)
  advances               Decimal? @db.Decimal(12, 2)
  nonPaidDays            Decimal? @db.Decimal(12, 2)
  epsAndPensionDiscount  Decimal? @db.Decimal(12, 2)
  employeeFundSavings    Decimal? @db.Decimal(12, 2)
  /// Suma de las OP del empleado que se le descuentan en este periodo.
  /// Lo mantiene el módulo `payroll-deductions`, no se digita a mano.
  orderDeductions        Decimal? @db.Decimal(12, 2)
  totalPayment           Decimal  @db.Decimal(12, 2)
  observations           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  period      PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id])
  extraShifts PayrollExtraShift[]
  deductions  PayrollDeduction[]

  @@unique([periodId, employeeId])
  @@map("payroll_items")
}

model PayrollExtraShift {
  id            String   @id @default(uuid())
  payrollItemId String
  shiftDate     DateTime @db.Date
  description   String?
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([payrollItemId])
  @@map("payroll_extra_shifts")
}

/// Estados del descuento de una OP sobre la nómina del empleado.
///
/// El dinero NO entra a caja en ningún momento: la empresa recupera el valor
/// del trabajo restándolo del pago de la nómina. Por eso la OP nace con saldo
/// pendiente y solo se salda en `APPLIED`, cuando el descuento ya está sobre
/// un `PayrollItem` real.
enum PayrollDeductionStatus {
  PENDING // Solicitado por el asesor, esperando aprobación de nómina/gerencia
  APPROVED // Autorizado, pendiente de aplicarse a un periodo
  REJECTED // Negado: la OP queda con saldo pendiente por cobrar de otra forma
  APPLIED // Ya descontado en la nómina; generó el `Payment` que salda la OP
  CANCELLED // Revertido antes de aplicarse (devolución, anulación de la OP…)
}

/// Cuenta por cobrar a un empleado por un trabajo hecho en la empresa, que se
/// recupera descontándolo de su nómina en vez de cobrarlo en caja.
///
/// Es el puente entre una OP y un `PayrollItem`. Al crear la OP con método
/// `PAYROLL_DEDUCTION` se registra un `Payment` de $0 (como el crédito) y esta
/// fila en `PENDING`; el `Payment` con el monto real —sin movimiento de caja—
/// solo se crea cuando el descuento se aplica sobre la nómina.
model PayrollDeduction {
  id String @id @default(uuid())

  /// Una OP se descuenta una sola vez. El `@unique` es la defensa real contra
  /// el doble descuento por doble clic, no el `findFirst` del servicio.
  orderId    String @unique @map("order_id")
  employeeId String @map("employee_id")

  /// Se llenan al aplicarlo. `paymentId` es `@unique` para que un mismo
  /// descuento no pueda generar dos abonos sobre la orden.
  payrollItemId String? @map("payroll_item_id")
  paymentId     String? @unique @map("payment_id")

  /// Valor a descontar. Se congela al momento de la solicitud; si la OP cambia
  /// de valor después, hay que cancelar el descuento y volver a solicitarlo.
  amount Decimal                @db.Decimal(12, 2)
  status PayrollDeductionStatus @default(PENDING)

  // Auditoría del flujo de aprobación
  requestedById   String    @map("requested_by_id")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  appliedById     String?   @map("applied_by_id")
  appliedAt       DateTime? @map("applied_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee    Employee     @relation(fields: [employeeId], references: [id])
  payrollItem PayrollItem? @relation(fields: [payrollItemId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  requestedBy User         @relation("RequestedPayrollDeductions", fields: [requestedById], references: [id])
  approvedBy  User?        @relation("ApprovedPayrollDeductions", fields: [approvedById], references: [id])
  appliedBy   User?        @relation("AppliedPayrollDeductions", fields: [appliedById], references: [id])

  @@index([employeeId])
  @@index([payrollItemId])
  @@index([status])
  @@map("payroll_deductions")
}

// ──────────────────────────────────────────
//  Attendance & Time Control
// ──────────────────────────────────────────

enum AttendanceType {
  MANUAL
  AUTO
}

enum AttendanceSource {
  BUTTON
  INACTIVITY
  LOGOUT
  SYSTEM
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
