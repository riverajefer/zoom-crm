generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  username           String?  @unique
  email              String?  @unique
  password           String
  refreshToken       String?
  roleId             String
  cargoId            String?
  profilePhoto       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  firstName          String?
  lastName           String?
  phone              String?
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)

  role                                      Role                                   @relation(fields: [roleId], references: [id])
  cargo                                     Cargo?                                 @relation(fields: [cargoId], references: [id])
  sessionLogs                               SessionLog[]
  createdOrders                             Order[]
  receivedPayments                          Payment[]                              @relation("ReceivedPayments")
  voidedPayments                            Payment[]                              @relation("VoidedPayments")
  requestedEditRequests                     OrderEditRequest[]                     @relation("RequestedEditRequests")
  reviewedEditRequests                      OrderEditRequest[]                     @relation("ReviewedEditRequests")
  requestedStatusChangeRequests             OrderStatusChangeRequest[]             @relation("RequestedStatusChangeRequests")
  reviewedStatusChangeRequests              OrderStatusChangeRequest[]             @relation("ReviewedStatusChangeRequests")
  requestedAdvisorChangeRequests            AdvisorChangeRequest[]                 @relation("AdvisorChangeRequested")
  currentAdvisorChangeRequests              AdvisorChangeRequest[]                 @relation("AdvisorChangeCurrent")
  targetAdvisorChangeRequests               AdvisorChangeRequest[]                 @relation("AdvisorChangeTarget")
  reviewedAdvisorChangeRequests             AdvisorChangeRequest[]                 @relation("AdvisorChangeReviewer")
  requestedQuoteRestoreRequests             QuoteRestoreRequest[]                  @relation("QuoteRestoreRequested")
  reviewedQuoteRestoreRequests              QuoteRestoreRequest[]                  @relation("QuoteRestoreReviewer")
  notifications                             Notification[]
  createdQuotes                             Quote[]
  appliedDiscounts                          OrderDiscount[]                        @relation("AppliedDiscounts")
  advisedWorkOrders                         WorkOrder[]                            @relation("WorkOrderAdvisor")
  designedWorkOrders                        WorkOrder[]                            @relation("WorkOrderDesigner")
  workOrderTimeEntries                      WorkOrderTimeEntry[]                   @relation("WorkOrderTimeEntryUser")
  authorizedExpenseOrders                   ExpenseOrder[]                         @relation("AuthorizedExpenseOrders")
  cajaAuthorizedExpenseOrders               ExpenseOrder[]                         @relation("CajaAuthorizedExpenseOrders")
  cajaRejectedExpenseOrders                 ExpenseOrder[]                         @relation("CajaRejectedExpenseOrders")
  responsibleExpenseOrders                  ExpenseOrder[]                         @relation("ResponsibleExpenseOrders")
  createdExpenseOrders                      ExpenseOrder[]                         @relation("CreatedExpenseOrders")
  approvedExpenseOrders                     ExpenseOrder[]                         @relation("ApprovedExpenseOrders")
  requestedExpenseOrderAuthRequests         ExpenseOrderAuthRequest[]              @relation("RequestedExpenseOrderAuthRequests")
  reviewedExpenseOrderAuthRequests          ExpenseOrderAuthRequest[]              @relation("ReviewedExpenseOrderAuthRequests")
  requestedAdvancePaymentApprovals          AdvancePaymentApproval[]               @relation("RequestedAdvancePaymentApprovals")
  reviewedAdvancePaymentApprovals           AdvancePaymentApproval[]               @relation("ReviewedAdvancePaymentApprovals")
  discountApprovalRequests                  DiscountApproval[]                     @relation("DiscountApprovalRequests")
  discountApprovalReviews                   DiscountApproval[]                     @relation("DiscountApprovalReviews")
  requestedPaymentEditApprovals             PaymentEditApproval[]                  @relation("RequestedPaymentEditApprovals")
  reviewedPaymentEditApprovals              PaymentEditApproval[]                  @relation("ReviewedPaymentEditApprovals")
  advisedClients                            ClientAdvisor[]                        @relation("ClientAdvisor")
  requestedClientAdvisorRequests            ClientAdvisorRequest[]                 @relation("ClientAdvisorRequestRequestedBy")
  advisedClientAdvisorRequests              ClientAdvisorRequest[]                 @relation("ClientAdvisorRequestAdvisor")
  reviewedClientAdvisorRequests             ClientAdvisorRequest[]                 @relation("ClientAdvisorRequestReviewer")
  requestedClientOwnershipAuthRequests      ClientOwnershipAuthRequest[]           @relation("RequestedClientOwnershipAuthRequests")
  advisedClientOwnershipAuthRequests        ClientOwnershipAuthRequest[]           @relation("AdvisedClientOwnershipAuthRequests")
  reviewedClientOwnershipAuthRequests       ClientOwnershipAuthRequest[]           @relation("ReviewedClientOwnershipAuthRequests")
  payrollEmployee                           Employee?
  requestedPayrollDeductions                PayrollDeduction[]                     @relation("RequestedPayrollDeductions")
  approvedPayrollDeductions                 PayrollDeduction[]                     @relation("ApprovedPayrollDeductions")
  appliedPayrollDeductions                  PayrollDeduction[]                     @relation("AppliedPayrollDeductions")
  attendanceRecords                         AttendanceRecord[]
  dtfRecords                                DtfRecord[]                            @relation("DtfCreatedBy")
  dtfStatusChanges                          DtfStatusHistory[]                     @relation("DtfStatusChangedBy")
  activityHeartbeats                        ActivityHeartbeat[]
  salesGoals                                SalesGoal[]                            @relation("AdvisorSalesGoals")
  inventoryMovements                        InventoryMovement[]
  productionOrdersCreated                   ProductionOrder[]                      @relation("ProductionOrderCreatedBy")
  productionStepsCompleted                  ProductionOrderStep[]                  @relation("ProductionStepCompletedBy")
  authoredComments                          Comment[]                              @relation("CommentAuthor")
  // Caja Registradora
  openedCashSessions                        CashSession[]                          @relation("OpenedCashSessions")
  closedCashSessions                        CashSession[]                          @relation("ClosedCashSessions")
  performedCashMovements                    CashMovement[]                         @relation("PerformedCashMovements")
  voidedCashMovements                       CashMovement[]                         @relation("VoidedCashMovements")
  requestedVoidRequests                     CashMovementVoidRequest[]              @relation("RequestedVoidRequests")
  reviewedVoidRequests                      CashMovementVoidRequest[]              @relation("ReviewedVoidRequests")
  requestedRefundRequests                   RefundRequest[]                        @relation("RequestedRefundRequests")
  reviewedRefundRequests                    RefundRequest[]                        @relation("ReviewedRefundRequests")
  executedRefundRequests                    RefundRequest[]                        @relation("ExecutedRefundRequests")
  // Cuentas por Pagar
  createdAccountsPayable                    AccountPayable[]                       @relation("AccountPayableCreatedBy")
  cancelledAccountsPayable                  AccountPayable[]                       @relation("AccountPayableCancelledBy")
  authorizedAccountsPayable                 AccountPayable[]                       @relation("AccountPayableAuthorizedBy")
  beneficiaryAccountsPayable                AccountPayable[]                       @relation("AccountPayableBeneficiary")
  registeredApPayments                      AccountPayablePayment[]                @relation("AccountPayablePaymentRegisteredBy")
  requestedApAuthRequests                   AccountPayableAuthRequest[]            @relation("RequestedApAuthRequests")
  reviewedApAuthRequests                    AccountPayableAuthRequest[]            @relation("ReviewedApAuthRequests")
  uploadedApAttachments                     AccountPayableAttachment[]             @relation("AccountPayableAttachmentUploadedBy")
  paidInstallments                          AccountPayableInstallment[]            @relation("InstallmentPaidBy")
  requestedApPaymentAuthRequests            AccountPayablePaymentAuthRequest[]     @relation("RequestedApPaymentAuthRequests")
  adminReviewedApPaymentAuthRequests        AccountPayablePaymentAuthRequest[]     @relation("AdminReviewedApPaymentAuthRequests")
  cajaReviewedApPaymentAuthRequests         AccountPayablePaymentAuthRequest[]     @relation("CajaReviewedApPaymentAuthRequests")
  requestedApPaymentReversalRequests        AccountPayablePaymentReversalRequest[] @relation("RequestedApPaymentReversalRequests")
  gerenciaReviewedApPaymentReversalRequests AccountPayablePaymentReversalRequest[] @relation("GerenciaReviewedApPaymentReversalRequests")
  cajaReviewedApPaymentReversalRequests     AccountPayablePaymentReversalRequest[] @relation("CajaReviewedApPaymentReversalRequests")
  // Pipeline de Ventas
  advisedProspects                          Prospect[]                             @relation("ProspectAdvisor")
  createdProspects                          Prospect[]                             @relation("ProspectCreatedBy")
  registeredProspectContacts                ProspectContact[]                      @relation("ProspectContactCreatedBy")

  @@map("users")
}

model Cargo {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productionAreaId String
  productionArea   ProductionArea @relation(fields: [productionAreaId], references: [id])

  users     User[]
  employees Employee[]

  @@unique([name, productionAreaId])
  @@map("cargos")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  recordId      String   @map("record_id")
  action        String
  model         String
  oldData       Json?    @map("old_data")
  newData       Json?    @map("new_data")
  changedFields Json?    @map("changed_fields")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([recordId])
  @@index([model, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// MÓDULO DE UBICACIONES (Departamentos y Ciudades de Colombia)
// =============================================================================

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities    City[]
  clients   Client[]
  suppliers Supplier[]

  @@map("departments")
}

model City {
  id           String   @id @default(uuid())
  name         String
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])
  clients    Client[]
  suppliers  Supplier[]

  @@unique([name, departmentId])
  @@map("cities")
}

// =============================================================================
// MÓDULO DE CLIENTES Y PROVEEDORES
// =============================================================================

enum PersonType {
  NATURAL
  EMPRESA
}

model Client {
  id               String     @id @default(uuid())
  name             String
  manager          String?
  encargado        String?
  phone            String?
  landlinePhone    String?    @map("landline_phone")
  address          String?
  email            String?    @unique
  departmentId     String     @map("department_id")
  cityId           String     @map("city_id")
  personType       PersonType @map("person_type")
  nit              String?
  cedula           String?
  specialCondition String?    @map("special_condition")
  /// Ficha de nómina cuando este cliente es a la vez empleado de la empresa.
  /// Habilita el método de pago `PAYROLL_DEDUCTION`. Es `@unique` para que dos
  /// fichas de cliente no puedan descontarle a la misma persona.
  employeeId       String?    @unique @map("employee_id")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  department      Department             @relation(fields: [departmentId], references: [id])
  city            City                   @relation(fields: [cityId], references: [id])
  employee        Employee?              @relation(fields: [employeeId], references: [id])
  advisors        ClientAdvisor[]
  advisorRequests ClientAdvisorRequest[]
  orders          Order[]
  quotes          Quote[]
  dtfRecords      DtfRecord[]
  prospects       Prospect[]

  @@map("clients")
}

/// Tabla de unión: un cliente puede pertenecer a varios asesores (co-propiedad).
model ClientAdvisor {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  advisorId String   @map("advisor_id")
  createdAt DateTime @default(now()) @map("created_at")

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  advisor User   @relation("ClientAdvisor", fields: [advisorId], references: [id])

  @@unique([clientId, advisorId])
  @@index([advisorId])
  @@map("client_advisors")
}

/// Solicitud (sujeta a aprobación del admin) de asignar un asesor a un cliente.
/// Al aprobar se crea la fila ClientAdvisor correspondiente.
model ClientAdvisorRequest {
  id                 String            @id @default(uuid())
  clientId           String            @map("client_id")
  requestedById      String            @map("requested_by_id")
  requestedAdvisorId String            @map("requested_advisor_id")
  reason             String?
  status             EditRequestStatus @default(PENDING)
  reviewedById       String?           @map("reviewed_by_id")
  reviewedAt         DateTime?         @map("reviewed_at")
  reviewNotes        String?           @map("review_notes")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  client           Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy      User   @relation("ClientAdvisorRequestRequestedBy", fields: [requestedById], references: [id])
  requestedAdvisor User   @relation("ClientAdvisorRequestAdvisor", fields: [requestedAdvisorId], references: [id])
  reviewedBy       User?  @relation("ClientAdvisorRequestReviewer", fields: [reviewedById], references: [id])

  @@index([clientId])
  @@index([requestedById])
  @@index([status])
  @@map("client_advisor_requests")
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  encargado     String?
  phone         String?
  landlinePhone String?    @map("landline_phone")
  address       String?
  email         String?    @unique
  departmentId  String     @map("department_id")
  cityId        String     @map("city_id")
  personType    PersonType @map("person_type")
  nit           String?
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  department        Department         @relation(fields: [departmentId], references: [id])
  city              City               @relation(fields: [cityId], references: [id])
  expenseOrderItems ExpenseOrderItem[]
  accountsPayable   AccountPayable[]

  @@map("suppliers")
}

// =============================================================================
// MÓDULO DE SESSION LOGS (Registros de inicio y cierre de sesión)
// =============================================================================

model SessionLog {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  loginAt   DateTime  @default(now()) @map("login_at")
  logoutAt  DateTime? @map("logout_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@index([logoutAt])
  @@map("session_logs")
}

// =============================================================================
// MÓDULO DE CATÁLOGOS - FASE 1: UNIDADES DE MEDIDA
// =============================================================================

model UnitOfMeasure {
  id           String   @id @default(uuid())
  name         String   @unique
  abbreviation String   @unique
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  suppliesAsPurchase    Supply[] @relation("PurchaseUnit")
  suppliesAsConsumption Supply[] @relation("ConsumptionUnit")

  @@map("units_of_measure")
}

// =============================================================================
// MÓDULO DE CATÁLOGOS - FASE 2: CATEGORÍAS DE PRODUCTOS
// =============================================================================

model ProductCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

// =============================================================================
// MÓDULO DE CATÁLOGOS - FASE 3: PRODUCTOS
// =============================================================================

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  basePrice   Decimal? @map("base_price")
  priceUnit   String?  @map("price_unit")
  categoryId  String   @map("category_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  quoteItems QuoteItem[]
  dtfRecords DtfRecord[]

  @@unique([name, categoryId])
  @@map("products")
}

// =============================================================================
// MÓDULO DE CATÁLOGOS - FASE 4: CATEGORÍAS DE INSUMOS
// =============================================================================

model SupplyCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplies Supply[]

  @@map("supply_categories")
}

// =============================================================================
// MÓDULO DE CATÁLOGOS - FASE 5: INSUMOS
// =============================================================================

model Supply {
  id                String   @id @default(uuid())
  name              String
  sku               String?  @unique
  description       String?
  categoryId        String   @map("category_id")
  purchasePrice     Decimal? @map("purchase_price")
  purchaseUnitId    String   @map("purchase_unit_id")
  consumptionUnitId String   @map("consumption_unit_id")
  conversionFactor  Decimal  @default(1) @map("conversion_factor")
  currentStock      Decimal  @default(0) @map("current_stock")
  minimumStock      Decimal  @default(0) @map("minimum_stock")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category        SupplyCategory        @relation(fields: [categoryId], references: [id])
  purchaseUnit    UnitOfMeasure         @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  consumptionUnit UnitOfMeasure         @relation("ConsumptionUnit", fields: [consumptionUnitId], references: [id])
  workOrderItems  WorkOrderItemSupply[]
  movements       InventoryMovement[]

  @@unique([name, categoryId])
  @@map("supplies")
}

// =============================================================================
// MÓDULO DE ÓRDENES - FASE 2: CONSECUTIVOS Y ÓRDENES DE PEDIDO
// =============================================================================

enum OrderStatus {
  DRAFT // Borrador (editable)
  CONFIRMED // Confirmada (bloqueada para edición)
  IN_PRODUCTION // En producción
  READY // Lista para entrega
  DELIVERED // Entregada
  DELIVERED_ON_CREDIT // Entregado a crédito
  WARRANTY // Garantía
  PAID // Pagada
  RETURNED // Devuelta
  ANULADO // Anulada (terminal, sin posibilidad de cambio de estado)
}

enum QuoteStatus {
  DRAFT
  SENT
  FOLLOW_UP_1 // Seguimiento 1: primer recordatorio al cliente
  FOLLOW_UP_2 // Seguimiento 2
  FOLLOW_UP_3 // Seguimiento 3: último antes de darla por perdida
  ACCEPTED
  NO_RESPONSE // Sin respuesta
  REJECTED // Rechazada por el cliente (requiere motivo)
  CONVERTED
}

model Consecutive {
  id         String   @id @default(uuid())
  type       String   @unique // "ORDER", "PRODUCTION", "EXPENSE", "QUOTE"
  prefix     String // "OP", "PROD", "GAS", "COT"
  year       Int // 2025, 2026, etc.
  lastNumber Int      @default(0) @map("last_number") // Último número generado
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("consecutives")
}

model Order {
  id           String    @id @default(uuid())
  orderNumber  String    @unique @map("order_number") // "OP-2025-0001"
  clientId     String    @map("client_id")
  orderDate    DateTime  @default(now()) @map("order_date")
  deliveryDate DateTime? @map("delivery_date") // Fecha estimada de entrega

  // Auditoría de cambios de fecha de entrega
  previousDeliveryDate  DateTime? @map("previous_delivery_date") // Última fecha de entrega anterior
  deliveryDateReason    String?   @map("delivery_date_reason") // Razón del cambio de fecha
  deliveryDateChangedAt DateTime? @map("delivery_date_changed_at") // Fecha del último cambio
  deliveryDateChangedBy String?   @map("delivery_date_changed_by") // Usuario que cambió la fecha

  // Cálculos financieros
  subtotal            Decimal // Suma de todos los items
  taxRate             Decimal @default(0.19) @map("tax_rate") // IVA 19%
  tax                 Decimal // subtotal * taxRate
  retefuenteRate      Decimal @default(0) @map("retefuente_rate") // Retefuente sobre subtotal (e.g., 0.025 = 2.5%)
  reteICARate         Decimal @default(0) @map("rete_ica_rate") // ReteICA sobre subtotal (e.g., 0.00414 = 0.414%)
  reteIVARate         Decimal @default(0) @map("rete_iva_rate") // ReteIVA sobre IVA (e.g., 0.15 = 15%)
  discountAmount      Decimal @default(0) @map("discount_amount") // Total de descuentos aplicados
  requiresColorProof  Boolean @default(false) @map("requires_color_proof") // ¿Requiere prueba de color?
  colorProofPrice     Decimal @default(0) @map("color_proof_price") // Precio de la prueba de color
  total               Decimal // subtotal - retenciones + tax - reteIVA - discountAmount + colorProofPrice
  paidAmount          Decimal @default(0) @map("paid_amount") // Abonos realizados, neto de devoluciones
  // Saldo a favor de ESTA orden que ya fue aplicado como pago de otras órdenes.
  // Se descuenta del excedente para que un mismo saldo no pueda usarse dos veces.
  appliedCreditAmount Decimal @default(0) @map("applied_credit_amount")
  // Total devuelto al cliente en efectivo por devoluciones aprobadas.
  // `paidAmount` ya viene neto; este campo existe para que al recalcularlo desde
  // los pagos no reaparezca el dinero devuelto (los Payment no se borran).
  refundedAmount      Decimal @default(0) @map("refunded_amount")
  // Valor de venta anulado por devoluciones de reversión (trabajo no conforme,
  // no entregado, fuerza mayor). Es distinto de `refundedAmount`: ese es el
  // dinero que salió de la caja, este es la parte de la venta que dejó de
  // existir. Sin él, devolverle la plata a un cliente que abonó menos del total
  // deja la OP debiendo el resto de un trabajo que ya no se va a hacer.
  reversedAmount      Decimal @default(0) @map("reversed_amount")
  // La misma anulación llevada a la moneda de la comisión: `subtotal - descuento`,
  // sin IVA ni el redondeo comercial del total. Se guarda calculada en lugar de
  // derivarse en cada consulta porque la base comisionable se arma con `_sum`
  // en un `groupBy` de Prisma, que no sabe prorratear.
  reversedNetAmount   Decimal @default(0) @map("reversed_net_amount")
  balance             Decimal // (total - reversedAmount) - paidAmount + appliedCreditAmount (saldo pendiente)

  // Estado de aprobación del anticipo (null = sin anticipo o auto-aprobado por admin/caja)
  advancePaymentStatus         EditRequestStatus? @map("advance_payment_status")
  advancePaymentRejectedReason String?            @map("advance_payment_rejected_reason")

  // Estado de aprobación de descuento (null = sin descuento pendiente o auto-aprobado)
  discountApprovalStatus EditRequestStatus? @map("discount_approval_status")

  // Estado de autorización de propiedad de cliente (null = no aplica o autorizado automáticamente)
  clientOwnershipAuthStatus EditRequestStatus? @map("client_ownership_auth_status")

  status       OrderStatus @default(DRAFT)
  notes        String? // Observaciones generales
  notesImageId String?     @map("notes_image_id") // Imagen adjunta a observaciones

  // Facturación electrónica (solo aplica cuando tax > 0)
  electronicInvoiceNumber String? @map("electronic_invoice_number") // Número de factura electrónica (máx 30 chars)

  // Auditoría
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  client                      Client                       @relation(fields: [clientId], references: [id])
  createdBy                   User                         @relation(fields: [createdById], references: [id])
  commercialChannelId         String?                      @map("commercial_channel_id")
  commercialChannel           CommercialChannel?           @relation(fields: [commercialChannelId], references: [id])
  items                       OrderItem[]
  payments                    Payment[]
  discounts                   OrderDiscount[]
  editRequests                OrderEditRequest[]
  statusChangeRequests        OrderStatusChangeRequest[]
  advisorChangeRequests       AdvisorChangeRequest[]
  advancePaymentApprovals     AdvancePaymentApproval[]
  discountApprovals           DiscountApproval[]
  paymentEditApprovals        PaymentEditApproval[]
  clientOwnershipAuthRequests ClientOwnershipAuthRequest[]
  refundRequests              RefundRequest[]
  creditApplications          CreditBalanceApplication[]   @relation("CreditSourceOrder")
  payrollDeduction            PayrollDeduction?

  // Referencia a la cotización de origen
  quoteId String? @unique @map("quote_id")
  quote   Quote?  @relation("QuoteToOrder")

  // Llave de idempotencia del formulario que originó la OP. El frontend la
  // genera una vez por formulario, así que un doble clic manda la misma llave
  // dos veces y la segunda petición devuelve la OP ya creada en lugar de gastar
  // otro consecutivo. Nula en las OPs anteriores a esta columna.
  idempotencyKey String? @unique @map("idempotency_key")

  workOrders WorkOrder[]
  dtfRecords DtfRecord[]
  prospects  Prospect[]

  @@index([clientId])
  @@index([createdById])
  @@index([orderDate])
  @@index([status])
  @@map("orders")
}

model Quote {
  id          String    @id @default(uuid())
  quoteNumber String    @unique @map("quote_number") // "COT-2025-0001"
  clientId    String    @map("client_id")
  quoteDate   DateTime  @default(now()) @map("quote_date")
  validUntil  DateTime? @map("valid_until") // Validez de la cotización

  // Cálculos financieros
  subtotal Decimal
  taxRate  Decimal @default(0.19) @map("tax_rate")
  tax      Decimal
  total    Decimal

  status QuoteStatus @default(DRAFT)
  notes  String?

  // Rechazo (obligatorio al pasar a REJECTED)
  rejectionReason String?   @map("rejection_reason")
  rejectedAt      DateTime? @map("rejected_at")
  // Estado desde el que se rechazó; es el destino al restaurarla
  rejectedFromStatus QuoteStatus? @map("rejected_from_status")

  // Auditoría
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  client              Client             @relation(fields: [clientId], references: [id])
  createdBy           User               @relation(fields: [createdById], references: [id])
  commercialChannelId String?            @map("commercial_channel_id")
  commercialChannel   CommercialChannel? @relation(fields: [commercialChannelId], references: [id])
  items               QuoteItem[]

  // Referencia a la orden si se convirtió
  orderId String? @unique @map("order_id")
  order   Order?  @relation("QuoteToOrder", fields: [orderId], references: [id])

  // Prospectos del pipeline que originaron esta cotización
  prospects Prospect[]

  restoreRequests QuoteRestoreRequest[]

  @@index([clientId])
  @@index([createdById])
  @@index([quoteDate])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String  @map("quote_id")
  productId String? @map("product_id")

  description String
  quantity    Decimal
  unitPrice   Decimal @map("unit_price")
  total       Decimal

  specifications Json?
  sampleImageId  String? @map("sample_image_id") // ID de la imagen de muestra

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quote           Quote                     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product         Product?                  @relation(fields: [productId], references: [id])
  productionAreas QuoteItemProductionArea[]

  @@index([quoteId])
  @@index([productId])
  @@index([sampleImageId])
  @@map("quote_items")
}

model QuoteItemProductionArea {
  quoteItemId      String
  productionAreaId String
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  quoteItem        QuoteItem      @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  productionArea   ProductionArea @relation(fields: [productionAreaId], references: [id], onDelete: Cascade)

  @@id([quoteItemId, productionAreaId])
  @@map("quote_item_production_areas")
}

model QuoteKanbanColumn {
  id           String      @id @default(uuid())
  name         String
  color        String      @default("#1976d2")
  displayOrder Int         @default(0) @map("display_order")
  isActive     Boolean     @default(true) @map("is_active")
  mappedStatus QuoteStatus @map("mapped_status")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("quote_kanban_columns")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String? @map("product_id") // Opcional: producto del catálogo

  // Datos del item
  description String // Descripción del servicio/producto
  quantity    Decimal // Cantidad
  unitPrice   Decimal @map("unit_price") // Precio unitario
  total       Decimal // quantity * unitPrice

  // Especificaciones técnicas (JSON flexible)
  specifications Json? // { color: "rojo", material: "acero", dimensiones: "10x20" }
  sampleImageId  String? @map("sample_image_id") // ID de la imagen de muestra

  sortOrder Int      @default(0) @map("sort_order") // Orden de visualización
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  order           Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?                  @relation(fields: [productId], references: [id])
  productionAreas OrderItemProductionArea[]
  workOrderItems  WorkOrderItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemProductionArea {
  orderItemId      String
  productionAreaId String
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productionArea   ProductionArea @relation(fields: [productionAreaId], references: [id], onDelete: Cascade)

  @@id([orderItemId, productionAreaId])
  @@map("order_item_production_areas")
}

enum PaymentMethod {
  CASH // Efectivo
  TRANSFER // Transferencia bancaria
  CARD // Tarjeta de crédito/débito
  CHECK // Cheque
  CREDIT // Crédito
  OTHER // Otro método
  CREDIT_BALANCE // Saldo a favor
  PAYROLL_DEDUCTION // Descuento por nómina (cliente empleado)
}

// Enums del módulo de Caja Registradora
enum CashSessionStatus {
  OPEN // Sesión abierta (en curso)
  CLOSED // Sesión cerrada
}

enum DenominationCountType {
  OPENING // Conteo de apertura
  CLOSING // Conteo de cierre
}

enum DenominationType {
  BILL // Billete
  COIN // Moneda
}

enum CashMovementType {
  INCOME // Ingreso (ej. pago de cliente, abono a OP)
  EXPENSE // Egreso (ej. gasto operativo, pago a proveedor)
  WITHDRAWAL // Retiro de efectivo (a caja fuerte / banco) — movimiento interno
  DEPOSIT // Depósito de efectivo adicional a la caja
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  amount        Decimal // Monto del pago
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paymentDate   DateTime      @default(now()) @map("payment_date")
  reference     String? // Número de referencia/comprobante
  notes         String? // Observaciones del pago
  bankEntity    String?       @map("bank_entity") // Entidad bancaria de origen (solo transferencias)
  receiptFileId String?       @map("receipt_file_id") // ID del archivo de comprobante (relación con UploadedFile)

  // Auditoría
  receivedById String   @map("received_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Vínculo opcional con movimiento de caja
  cashMovementId String? @unique @map("cash_movement_id")

  // Abono registrado sin caja abierta: queda en cola y entra al arqueo cuando
  // se abra la próxima sesión. Evita que el pago nazca huérfano sin frenar a la
  // comercial que cobra fuera del horario de caja.
  pendingCashEntry Boolean @default(false) @map("pending_cash_entry")

  // Anulación. El pago no se borra: la fila sobrevive marcada para que el
  // Historial de Pagos siga contando qué pasó y quién lo autorizó. Un pago
  // anulado no suma a `paidAmount` (ver `sumActivePayments`).
  isVoided   Boolean   @default(false) @map("is_voided")
  voidedById String?   @map("voided_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidReason String?   @map("void_reason")

  // Llave de idempotencia del diálogo que registró el abono. Se regenera cada
  // vez que se abre el diálogo, así que dos abonos distintos a la misma orden
  // llevan llaves distintas, pero un doble clic sobre el mismo abono manda la
  // misma y la segunda petición devuelve el pago ya creado en vez de inflar
  // `paidAmount` y el arqueo de caja.
  idempotencyKey String? @unique @map("idempotency_key")

  // Relaciones
  order                  Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy             User                       @relation("ReceivedPayments", fields: [receivedById], references: [id])
  voidedBy               User?                      @relation("VoidedPayments", fields: [voidedById], references: [id])
  advancePaymentApproval AdvancePaymentApproval?
  paymentEditApprovals   PaymentEditApproval[]
  cashMovement           CashMovement?              @relation(fields: [cashMovementId], references: [id])
  creditApplications     CreditBalanceApplication[]
  voidRequests           CashMovementVoidRequest[]
  payrollDeduction       PayrollDeduction?

  @@index([orderId])
  // Lo usan todos los recálculos de saldo (suman solo los pagos vivos de una
  // OP). Existía en la base sin estar declarado, así que el próximo
  // `migrate dev` lo habría borrado.
  @@index([orderId, isVoided])
  @@index([receivedById])
  @@index([paymentDate])
  @@index([receiptFileId])
  @@index([pendingCashEntry])
  @@map("payments")
}

/// Consumo de saldo a favor: vincula un pago con método CREDIT_BALANCE con la(s)
/// orden(es) de origen de donde sale ese saldo. Permite revertir la aplicación si
/// el pago se elimina o se edita, y evita que un mismo excedente se gaste dos veces.
model CreditBalanceApplication {
  id            String   @id @default(uuid())
  paymentId     String   @map("payment_id") // Pago CREDIT_BALANCE que consume el saldo
  sourceOrderId String   @map("source_order_id") // OP con saldo a favor de donde proviene
  amount        Decimal // Monto tomado de esa OP de origen
  createdAt     DateTime @default(now()) @map("created_at")

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sourceOrder Order   @relation("CreditSourceOrder", fields: [sourceOrderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([sourceOrderId])
  @@map("credit_balance_applications")
}

model OrderDiscount {
  id      String  @id @default(uuid())
  orderId String  @map("order_id")
  amount  Decimal // Monto del descuento
  reason  String // Motivo/razón del descuento (obligatorio)

  // Auditoría
  appliedById String   @map("applied_by_id")
  appliedAt   DateTime @default(now()) @map("applied_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  appliedBy User               @relation("AppliedDiscounts", fields: [appliedById], references: [id])
  approvals DiscountApproval[]

  @@index([orderId])
  @@index([appliedById])
  @@index([appliedAt])
  @@map("order_discounts")
}

// =============================================================================
// MÓDULO DE SOLICITUDES DE EDICIÓN DE ÓRDENES
// =============================================================================

enum EditRequestStatus {
  PENDING // Pendiente de aprobación
  APPROVED // Aprobada
  REJECTED // Rechazada
  EXPIRED // Expirada (permiso venció)
}

/// Por qué se devuelve la plata. Sin esto no hay forma de responder dentro de
/// seis meses "¿cuánto devolvimos por calidad?": la observación es texto libre.
enum RefundReason {
  CREDIT_BALANCE // Saldo a favor: el cliente pagó de más. No anula venta.
  QUALITY // El trabajo no cumplió (resolución, color, acabado)
  DELIVERY_DELAY // Se incumplió el tiempo de entrega
  FORCE_MAJEURE // Corte de luz, falla de máquina, causa externa
  CLIENT_WITHDRAWAL // El cliente desistió de la compra
  OTHER // Otro motivo (la observación lo explica)
}

enum ApprovalRequestType {
  ORDER_EDIT
  STATUS_CHANGE
  EXPENSE_ORDER_AUTH
  CLIENT_OWNERSHIP_AUTH
  ADVANCE_PAYMENT
  DISCOUNT_APPROVAL
  PAYMENT_EDIT
  CASH_MOVEMENT_VOID
  REFUND_REQUEST
  AP_AUTH
  AP_PAYMENT_AUTH
  ADVISOR_CHANGE
  CLIENT_ADVISOR_ASSIGNMENT
  QUOTE_RESTORE
}

enum NotificationType {
  EDIT_REQUEST_PENDING // Nueva solicitud de edición
  EDIT_REQUEST_APPROVED // Solicitud aprobada
  EDIT_REQUEST_REJECTED // Solicitud rechazada
  EDIT_PERMISSION_EXPIRING // Permiso por expirar (1 min antes)
  EDIT_PERMISSION_EXPIRED // Permiso expirado
  STATUS_CHANGE_REQUEST_PENDING // Nueva solicitud de cambio de estado
  STATUS_CHANGE_REQUEST_APPROVED // Solicitud de cambio de estado aprobada
  STATUS_CHANGE_REQUEST_REJECTED // Solicitud de cambio de estado rechazada
  EXPENSE_ORDER_AUTH_REQUEST_PENDING // Nueva solicitud de autorización de OG
  EXPENSE_ORDER_AUTH_REQUEST_APPROVED // Solicitud de autorización de OG aprobada
  EXPENSE_ORDER_AUTH_REQUEST_REJECTED // Solicitud de autorización de OG rechazada
  ADVANCE_PAYMENT_APPROVAL_PENDING // Nueva solicitud de aprobación de anticipo
  ADVANCE_PAYMENT_APPROVAL_APPROVED // Anticipo aprobado
  ADVANCE_PAYMENT_APPROVAL_REJECTED // Anticipo rechazado
  LOW_STOCK_ALERT // Alerta de stock bajo en insumo
  CLIENT_OWNERSHIP_AUTH_PENDING // Nueva solicitud de autorización de propiedad de cliente
  CLIENT_OWNERSHIP_AUTH_APPROVED // Solicitud de autorización aprobada
  CLIENT_OWNERSHIP_AUTH_REJECTED // Solicitud de autorización rechazada
  DISCOUNT_APPROVAL_PENDING // Nueva solicitud de aprobación de descuento
  DISCOUNT_APPROVAL_APPROVED // Descuento aprobado
  DISCOUNT_APPROVAL_REJECTED // Descuento rechazado
  PAYMENT_EDIT_APPROVAL_PENDING // Nueva solicitud de edición de pago
  PAYMENT_EDIT_APPROVAL_APPROVED // Edición de pago aprobada
  PAYMENT_EDIT_APPROVAL_REJECTED // Edición de pago rechazada
  CASH_SESSION_CLOSED_WITH_DISCREPANCY // Sesión de caja cerrada con descuadre
  CASH_LARGE_WITHDRAWAL // Retiro grande de efectivo de caja
  CASH_VOID_REQUEST_PENDING // Nueva solicitud de anulación de movimiento de caja
  CASH_VOID_REQUEST_APPROVED // Solicitud de anulación de movimiento aprobada
  CASH_VOID_REQUEST_REJECTED // Solicitud de anulación de movimiento rechazada
  REFUND_REQUEST_PENDING // Nueva solicitud de devolución de dinero al cliente
  REFUND_REQUEST_APPROVED // Devolución aprobada
  AP_AUTH_REQUEST_PENDING // Nueva solicitud de autorización de Cuenta por Pagar
  AP_AUTH_REQUEST_APPROVED // Solicitud de autorización de CP aprobada
  AP_AUTH_REQUEST_REJECTED // Solicitud de autorización de CP rechazada
  REFUND_REQUEST_REJECTED // Devolución rechazada
  AP_PAYMENT_AUTH_PENDING // Nueva solicitud de pago de CP (paso 1 — admin)
  AP_PAYMENT_AUTH_ADMIN_APPROVED // Admin aprobó pago de CP — pendiente de Caja
  AP_PAYMENT_AUTH_ADMIN_REJECTED // Admin rechazó solicitud de pago de CP
  AP_PAYMENT_AUTH_COMPLETED // Caja completó el pago de CP
  AP_PAYMENT_AUTH_CAJA_REJECTED // Caja rechazó el pago de CP
  AP_PAYMENT_REVERSAL_REQUESTED // Solicitud de reversión creada
  AP_PAYMENT_REVERSAL_GERENCIA_APPROVED // Gerencia aprobó reversión — pendiente de Caja
  AP_PAYMENT_REVERSAL_GERENCIA_REJECTED // Gerencia rechazó reversión
  AP_PAYMENT_REVERSAL_COMPLETED // Caja confirmó reversión — pago revertido
  AP_PAYMENT_REVERSAL_CAJA_REJECTED // Caja rechazó la reversión
  APPROVAL_REQUEST_EXPIRED // Solicitud vencida sin respuesta (barrido automático)
  ADVISOR_CHANGE_REQUEST_PENDING // Nueva solicitud de cambio de asesor de OP
  ADVISOR_CHANGE_REQUEST_APPROVED // Solicitud de cambio de asesor aprobada
  ADVISOR_CHANGE_REQUEST_REJECTED // Solicitud de cambio de asesor rechazada
  QUOTE_RESTORE_REQUEST_PENDING // Nueva solicitud de restaurar una cotización rechazada
  QUOTE_RESTORE_REQUEST_APPROVED // Restauración de cotización aprobada
  QUOTE_RESTORE_REQUEST_REJECTED // Restauración de cotización rechazada
  CLIENT_ADVISOR_REQUEST_PENDING // Nueva solicitud de asignación de asesor a cliente
  CLIENT_ADVISOR_REQUEST_APPROVED // Solicitud de asignación de asesor a cliente aprobada
  CLIENT_ADVISOR_REQUEST_REJECTED // Solicitud de asignación de asesor a cliente rechazada
  PAYROLL_DEDUCTION_PENDING // Nueva solicitud de descuento de una OP por nómina
  PAYROLL_DEDUCTION_APPROVED // Descuento por nómina aprobado
  PAYROLL_DEDUCTION_REJECTED // Descuento por nómina rechazado
  PAYROLL_DEDUCTION_APPLIED // Descuento aplicado sobre la nómina del periodo
}

enum ApPaymentAuthRequestStatus {
  PENDING // Esperando aprobación de Admin
  ADMIN_APPROVED // Admin aprobó — esperando autorización de Caja
  COMPLETED // Caja autorizó y registró el pago
  ADMIN_REJECTED // Admin rechazó
  CAJA_REJECTED // Caja rechazó
  EXPIRED // Vencida sin respuesta (barrido automático)
}

model EditableOrderStatus {
  id                String      @id @default(uuid())
  orderStatus       OrderStatus @unique @map("order_status")
  allowEditRequests Boolean     @default(true) @map("allow_edit_requests")
  description       String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("editable_order_statuses")
}

model OrderEditRequest {
  id            String            @id @default(uuid())
  orderId       String            @map("order_id")
  requestedById String            @map("requested_by_id")
  observations  String?
  status        EditRequestStatus @default(PENDING)

  // Aprobación/rechazo
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")

  // Permiso temporal (5 minutos)
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedEditRequests", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("ReviewedEditRequests", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@index([expiresAt])
  @@map("order_edit_requests")
}

// Contexto de acción para botones quick-reply de templates de WhatsApp.
// Vincula el messageId devuelto por Meta con la solicitud correspondiente.
// Se usa para resolver qué requestId aprobar/rechazar cuando el admin toca un botón.
model WhatsappActionContext {
  id          String              @id @default(uuid())
  messageId   String              @unique @map("message_id") // wamid.XXX devuelto por Meta
  requestId   String              @map("request_id") // ID de la solicitud (polimórfico)
  requestType ApprovalRequestType @default(ORDER_EDIT) @map("request_type") // tipo de solicitud
  adminPhone  String              @map("admin_phone") // teléfono normalizado E.164 sin "+"
  expiresAt   DateTime            @map("expires_at") // now + 48h
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([messageId])
  @@index([expiresAt])
  @@map("whatsapp_action_contexts")
}

model OrderStatusChangeRequest {
  id              String            @id @default(uuid())
  orderId         String            @map("order_id")
  requestedById   String            @map("requested_by_id")
  currentStatus   OrderStatus       @map("current_status")
  requestedStatus OrderStatus       @map("requested_status")
  reason          String?
  status          EditRequestStatus @default(PENDING)

  // Solo en anulaciones: lo que la empresa se queda de lo pagado. El resto queda
  // como saldo a favor del cliente. Viaja en la solicitud para que el admin lo
  // vea antes de aprobar; null en solicitudes anteriores = se reconoce todo.
  retainedAmount Decimal? @map("retained_amount")

  // Aprobación/rechazo
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedStatusChangeRequests", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("ReviewedStatusChangeRequests", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@map("order_status_change_requests")
}

model AdvisorChangeRequest {
  id                 String            @id @default(uuid())
  orderId            String            @map("order_id")
  requestedById      String            @map("requested_by_id")
  currentAdvisorId   String            @map("current_advisor_id")
  requestedAdvisorId String            @map("requested_advisor_id")
  reason             String?
  status             EditRequestStatus @default(PENDING)

  // Aprobación/rechazo
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  order            Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // `NoAction` es lo que creó la migración al no declarar la cláusula.
  requestedBy      User  @relation("AdvisorChangeRequested", fields: [requestedById], references: [id], onDelete: NoAction)
  currentAdvisor   User  @relation("AdvisorChangeCurrent", fields: [currentAdvisorId], references: [id], onDelete: NoAction)
  requestedAdvisor User  @relation("AdvisorChangeTarget", fields: [requestedAdvisorId], references: [id], onDelete: NoAction)
  reviewedBy       User? @relation("AdvisorChangeReviewer", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@map("advisor_change_requests")
}

/// Solicitud para deshacer el rechazo de una cotización.
/// Aprobarla devuelve la cotización a `restoreToStatus` y limpia el motivo;
/// el motivo que se deshizo queda copiado aquí como traza.
model QuoteRestoreRequest {
  id                      String            @id @default(uuid())
  quoteId                 String            @map("quote_id")
  requestedById           String            @map("requested_by_id")
  restoreToStatus         QuoteStatus       @map("restore_to_status")
  previousRejectionReason String?           @map("previous_rejection_reason")
  previousRejectedAt      DateTime?         @map("previous_rejected_at")
  reason                  String
  status                  EditRequestStatus @default(PENDING)

  // Aprobación/rechazo
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  quote       Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // `NoAction` es lo que creó la migración al no declarar la cláusula.
  requestedBy User  @relation("QuoteRestoreRequested", fields: [requestedById], references: [id], onDelete: NoAction)
  reviewedBy  User? @relation("QuoteRestoreReviewer", fields: [reviewedById], references: [id])

  @@index([quoteId])
  @@index([requestedById])
  @@index([status])
  @@map("quote_restore_requests")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  relatedId   String?          @map("related_id")
  relatedType String?          @map("related_type")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relación
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// MÓDULO DE ÁREAS DE PRODUCCIÓN
// =============================================================================

model ProductionArea {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cargos            Cargo[]
  orderItems        OrderItemProductionArea[]
  quoteItems        QuoteItemProductionArea[]
  workOrderItems    WorkOrderItemProductionArea[]
  expenseOrderItems ExpenseOrderItemProductionArea[]

  @@map("production_areas")
}

// =============================================================================
// MÓDULO DE CANALES DE VENTA (COMMERCIAL CHANNELS)
// =============================================================================

model CommercialChannel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders Order[]
  quotes Quote[]

  @@map("commercial_channels")
}

model UploadedFile {
  id           String      @id @default(uuid())
  originalName String      @map("original_name")
  fileName     String      @unique @map("file_name")
  mimeType     String      @map("mime_type")
  size         Int
  s3Key        String      @unique @map("s3_key")
  s3Bucket     String      @map("s3_bucket")
  entityType   String?     @map("entity_type")
  entityId     String?     @map("entity_id")
  uploadedBy   String?     @map("uploaded_by")
  isDeleted    Boolean     @default(false) @map("is_deleted")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  workOrders   WorkOrder[] @relation("WorkOrderAttachment1")
  workOrders2  WorkOrder[] @relation("WorkOrderAttachment2")

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([isDeleted])
  @@map("uploaded_files")
}

// =============================================================================
// MÓDULO DE INFORMACIÓN DE LA COMPAÑÍA
// =============================================================================
// =============================================================================
// MÓDULO DE ÓRDENES DE TRABAJO (OT)
// =============================================================================

enum WorkOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum WorkOrderTimeEntryType {
  HOURS
  RANGE
}

model WorkOrder {
  id              String          @id @default(uuid())
  workOrderNumber String          @unique @map("work_order_number") // "OT-2025-0001"
  orderId         String          @map("order_id")
  advisorId       String          @map("advisor_id")
  designerId      String?         @map("designer_id")
  fileName        String?         @map("file_name") // max 30 chars
  attachmentId    String?         @map("attachment_id")
  attachment2Id   String?         @map("attachment2_id")
  observations    String?
  status          WorkOrderStatus @default(DRAFT)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  order            Order                @relation(fields: [orderId], references: [id])
  advisor          User                 @relation("WorkOrderAdvisor", fields: [advisorId], references: [id])
  designer         User?                @relation("WorkOrderDesigner", fields: [designerId], references: [id])
  attachment       UploadedFile?        @relation("WorkOrderAttachment1", fields: [attachmentId], references: [id])
  attachment2      UploadedFile?        @relation("WorkOrderAttachment2", fields: [attachment2Id], references: [id])
  items            WorkOrderItem[]
  timeEntries      WorkOrderTimeEntry[]
  expenseOrders    ExpenseOrder[]
  productionOrders ProductionOrder[]

  @@index([orderId])
  @@index([advisorId])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderItem {
  id                 String   @id @default(uuid())
  workOrderId        String   @map("work_order_id")
  orderItemId        String   @map("order_item_id")
  productDescription String   @map("product_description")
  observations       String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workOrder       WorkOrder                     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  // Cascade: al eliminar un ítem de la OP, su contraparte en la OT se va con él.
  // Antes era Restrict (default de Prisma) y editar una OP con OT asociada
  // reventaba con P2003 → 500. Los registros de tiempo NO se pierden: quedan
  // colgados de la OT con `workOrderItemId` en NULL (onDelete: SetNull).
  orderItem       OrderItem                     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productionAreas WorkOrderItemProductionArea[]
  supplies        WorkOrderItemSupply[]
  timeEntries     WorkOrderTimeEntry[]

  @@index([workOrderId])
  @@index([orderItemId])
  @@map("work_order_items")
}

model WorkOrderItemProductionArea {
  workOrderItemId  String
  productionAreaId String
  assignedAt       DateTime @default(now()) @map("assigned_at")

  workOrderItem  WorkOrderItem  @relation(fields: [workOrderItemId], references: [id], onDelete: Cascade)
  productionArea ProductionArea @relation(fields: [productionAreaId], references: [id], onDelete: Cascade)

  @@id([workOrderItemId, productionAreaId])
  @@map("work_order_item_production_areas")
}

model WorkOrderItemSupply {
  id              String   @id @default(uuid())
  workOrderItemId String   @map("work_order_item_id")
  supplyId        String   @map("supply_id")
  quantity        Decimal?
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id], onDelete: Cascade)
  supply        Supply        @relation(fields: [supplyId], references: [id])

  @@unique([workOrderItemId, supplyId])
  @@index([workOrderItemId])
  @@index([supplyId])
  @@map("work_order_item_supplies")
}

model WorkOrderTimeEntry {
  id              String                 @id @default(uuid())
  workOrderId     String                 @map("work_order_id")
  workOrderItemId String?                @map("work_order_item_id")
  userId          String                 @map("user_id")
  entryType       WorkOrderTimeEntryType @map("entry_type")
  workedDate      DateTime               @map("worked_date")
  hoursWorked     Decimal                @map("hours_worked")
  startAt         DateTime?              @map("start_at")
  endAt           DateTime?              @map("end_at")
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderItem WorkOrderItem? @relation(fields: [workOrderItemId], references: [id], onDelete: SetNull)
  user          User           @relation("WorkOrderTimeEntryUser", fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([workOrderItemId])
  @@index([userId])
  @@index([workedDate])
  @@map("work_order_time_entries")
}

// =============================================================================
// MÓDULO DE ÓRDENES DE GASTOS (OG)
// =============================================================================

enum ExpenseOrderStatus {
  DRAFT // Borrador (editable)
  CREATED // Creada
  ADMIN_AUTHORIZED // Pre-autorizada por Admin (pendiente de Caja)
  AUTHORIZED // Autorizada por Caja (registra pago)
  PAID // Pagada
}

model ExpenseType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subcategories   ExpenseSubcategory[]
  expenseOrders   ExpenseOrder[]
  accountsPayable AccountPayable[]

  @@map("expense_types")
}

model ExpenseSubcategory {
  id            String   @id @default(uuid())
  name          String
  description   String?
  expenseTypeId String   @map("expense_type_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  expenseType     ExpenseType      @relation(fields: [expenseTypeId], references: [id])
  expenseOrders   ExpenseOrder[]
  accountsPayable AccountPayable[]

  @@unique([name, expenseTypeId])
  @@map("expense_subcategories")
}

model ExpenseOrder {
  id                   String             @id @default(uuid())
  ogNumber             String             @unique @map("og_number") // "OG-2026-001"
  expenseTypeId        String             @map("expense_type_id")
  expenseSubcategoryId String             @map("expense_subcategory_id")
  workOrderId          String?            @map("work_order_id") // Opcional: OT asociada
  authorizedToId       String?            @map("authorized_to_id") // Usuario autorizado (opcional)
  responsibleId        String?            @map("responsible_id") // Responsable (opcional)
  observations         String?
  areaOrMachine        String?            @map("area_or_machine")
  applyIva             Boolean            @default(false) @map("apply_iva")
  ivaRate              Decimal            @default(0.19) @map("iva_rate")
  // Retenciones que la empresa le practica al proveedor: bajan lo que hay que
  // pagarle. Mismas bases que en la OP (retefuente/ReteICA sobre el subtotal,
  // ReteIVA sobre el IVA).
  retefuenteRate       Decimal            @default(0) @map("retefuente_rate")
  reteICARate          Decimal            @default(0) @map("rete_ica_rate")
  reteIVARate          Decimal            @default(0) @map("rete_iva_rate")
  status               ExpenseOrderStatus @default(DRAFT)

  // Número de factura electrónica del proveedor asociado a la compra.
  // La columna es VARCHAR(30) en la base: el `@db.VarChar` lo deja explícito
  // (en `orders` la equivalente sí es TEXT).
  electronicInvoiceNumber String? @map("electronic_invoice_number") @db.VarChar(30)

  // Llave de idempotencia del formulario que originó la OG. El frontend la
  // genera una vez por formulario, así que un doble clic manda la misma llave
  // dos veces y la segunda petición devuelve la OG ya creada en lugar de gastar
  // otro consecutivo. Nula en las OGs anteriores a esta columna.
  idempotencyKey String? @unique @map("idempotency_key")

  // Auditoría
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Primera autorización Admin (quién aprobó el cambio a ADMIN_AUTHORIZED)
  authorizedById String?   @map("authorized_by_id")
  authorizedAt   DateTime? @map("authorized_at")

  // Segunda autorización Caja (quién aprobó el cambio a AUTHORIZED y registró el pago)
  cajaAuthorizedById String?   @map("caja_authorized_by_id")
  cajaAuthorizedAt   DateTime? @map("caja_authorized_at")

  // Rechazo Caja (cuando Caja rechaza una OG en ADMIN_AUTHORIZED y la devuelve a CREATED)
  cajaRejectedById    String?   @map("caja_rejected_by_id")
  cajaRejectedAt      DateTime? @map("caja_rejected_at")
  cajaRejectionReason String?   @map("caja_rejection_reason")

  // Relaciones
  expenseType        ExpenseType               @relation(fields: [expenseTypeId], references: [id])
  expenseSubcategory ExpenseSubcategory        @relation(fields: [expenseSubcategoryId], references: [id])
  workOrder          WorkOrder?                @relation(fields: [workOrderId], references: [id])
  // La migración la creó con `RESTRICT`, no con el `SET NULL` que Prisma
  // asume por defecto en una relación opcional.
  authorizedTo       User?                     @relation("AuthorizedExpenseOrders", fields: [authorizedToId], references: [id], onDelete: Restrict)
  responsible        User?                     @relation("ResponsibleExpenseOrders", fields: [responsibleId], references: [id])
  createdBy          User                      @relation("CreatedExpenseOrders", fields: [createdById], references: [id])
  authorizedBy       User?                     @relation("ApprovedExpenseOrders", fields: [authorizedById], references: [id])
  cajaAuthorizedBy   User?                     @relation("CajaAuthorizedExpenseOrders", fields: [cajaAuthorizedById], references: [id])
  cajaRejectedBy     User?                     @relation("CajaRejectedExpenseOrders", fields: [cajaRejectedById], references: [id])
  items              ExpenseOrderItem[]
  authRequests       ExpenseOrderAuthRequest[]
  accountPayable     AccountPayable?

  @@index([status])
  @@index([workOrderId])
  @@index([createdById])
  @@index([createdAt])
  @@map("expense_orders")
}

model ExpenseOrderItem {
  id              String        @id @default(uuid())
  expenseOrderId  String        @map("expense_order_id")
  quantity        Decimal
  name            String // Nombre del gasto
  description     String?
  supplierId      String?       @map("supplier_id") // Proveedor (opcional)
  unitPrice       Decimal       @map("unit_price")
  total           Decimal // quantity * unitPrice
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  bankEntity      String?       @map("bank_entity") // Entidad bancaria de origen (solo transferencias)
  receiptFileId   String?       @map("receipt_file_id") // Comprobante de pago
  referenceFileId String?       @map("reference_file_id") // Imagen de referencia

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenseOrder    ExpenseOrder                     @relation(fields: [expenseOrderId], references: [id], onDelete: Cascade)
  supplier        Supplier?                        @relation(fields: [supplierId], references: [id])
  productionAreas ExpenseOrderItemProductionArea[]

  @@index([expenseOrderId])
  @@map("expense_order_items")
}

model ExpenseOrderItemProductionArea {
  expenseOrderItemId String
  productionAreaId   String
  assignedAt         DateTime @default(now()) @map("assigned_at")

  expenseOrderItem ExpenseOrderItem @relation(fields: [expenseOrderItemId], references: [id], onDelete: Cascade)
  productionArea   ProductionArea   @relation(fields: [productionAreaId], references: [id], onDelete: Cascade)

  @@id([expenseOrderItemId, productionAreaId])
  @@map("expense_order_item_production_areas")
}

model ExpenseOrderAuthRequest {
  id             String            @id @default(uuid())
  expenseOrderId String            @map("expense_order_id")
  requestedById  String            @map("requested_by_id")
  reason         String?
  status         EditRequestStatus @default(PENDING)
  reviewedById   String?           @map("reviewed_by_id")
  reviewedAt     DateTime?         @map("reviewed_at")
  reviewNotes    String?           @map("review_notes")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  expenseOrder ExpenseOrder @relation(fields: [expenseOrderId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("RequestedExpenseOrderAuthRequests", fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("ReviewedExpenseOrderAuthRequests", fields: [reviewedById], references: [id])

  @@index([expenseOrderId])
  @@index([requestedById])
  @@index([status])
  @@map("expense_order_auth_requests")
}

model AccountPayableAuthRequest {
  id               String            @id @default(uuid())
  accountPayableId String            @map("account_payable_id")
  requestedById    String            @map("requested_by_id")
  reason           String?
  status           EditRequestStatus @default(PENDING)
  reviewedById     String?           @map("reviewed_by_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewNotes      String?           @map("review_notes")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("RequestedApAuthRequests", fields: [requestedById], references: [id])
  reviewedBy     User?          @relation("ReviewedApAuthRequests", fields: [reviewedById], references: [id])

  @@index([accountPayableId])
  @@index([requestedById])
  @@index([status])
  @@map("account_payable_auth_requests")
}

// =============================================================================
// MÓDULO DE APROBACIÓN DE ANTICIPOS
// =============================================================================

model AdvancePaymentApproval {
  id String @id @default(uuid())

  orderId String @map("order_id")

  // Nullable a propósito: al rechazar se elimina el pago, y la solicitud debe
  // sobrevivir como registro de auditoría (ON DELETE SET NULL).
  paymentId String? @unique @map("payment_id")

  // Snapshot del pago solicitado. Se conserva aunque el pago sea eliminado.
  paymentAmount Decimal?       @map("payment_amount")
  paymentMethod PaymentMethod? @map("payment_method")

  requestedById String            @map("requested_by_id")
  reason        String?
  status        EditRequestStatus @default(PENDING)
  reviewedById  String?           @map("reviewed_by_id")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNotes   String?           @map("review_notes")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  requestedBy User     @relation("RequestedAdvancePaymentApprovals", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("ReviewedAdvancePaymentApprovals", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
  @@map("advance_payment_approvals")
}

// =============================================================================
// MÓDULO DE APROBACIÓN DE DESCUENTOS
// =============================================================================

model DiscountApproval {
  id            String            @id @default(uuid())
  orderId       String            @map("order_id")
  discountId    String            @map("discount_id")
  requestedById String            @map("requested_by_id")
  status        EditRequestStatus @default(PENDING)
  reviewedById  String?           @map("reviewed_by_id")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNotes   String?           @map("review_notes")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount    OrderDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("DiscountApprovalRequests", fields: [requestedById], references: [id])
  reviewedBy  User?         @relation("DiscountApprovalReviews", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([discountId])
  @@index([requestedById])
  @@index([status])
  @@map("discount_approvals")
}

// =============================================================================
// MÓDULO DE APROBACIÓN DE EDICIÓN DE PAGOS
// =============================================================================

model PaymentEditApproval {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  paymentId     String  @map("payment_id")
  requestedById String  @map("requested_by_id")
  reason        String?

  // Snapshot de valores anteriores (auditoría)
  oldAmount        Decimal       @map("old_amount")
  oldPaymentMethod PaymentMethod @map("old_payment_method")
  oldPaymentDate   DateTime      @map("old_payment_date")
  oldReference     String?       @map("old_reference")
  oldNotes         String?       @map("old_notes")
  oldBankEntity    String?       @map("old_bank_entity")
  oldReceiptFileId String?       @map("old_receipt_file_id")

  // Payload pendiente: valores solicitados (null = sin cambio)
  newAmount        Decimal?       @map("new_amount")
  newPaymentMethod PaymentMethod? @map("new_payment_method")
  newPaymentDate   DateTime?      @map("new_payment_date")
  newReference     String?        @map("new_reference")
  newNotes         String?        @map("new_notes")
  newBankEntity    String?        @map("new_bank_entity")
  // Comprobante propuesto (ya subido a storage, sin enlazar al pago hasta aprobar)
  newReceiptFileId String?        @map("new_receipt_file_id")

  status       EditRequestStatus @default(PENDING)
  reviewedById String?           @map("reviewed_by_id")
  reviewedAt   DateTime?         @map("reviewed_at")
  reviewNotes  String?           @map("review_notes")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedPaymentEditApprovals", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ReviewedPaymentEditApprovals", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@index([requestedById])
  @@index([status])
  @@map("payment_edit_approvals")
}

// =============================================================================
// MÓDULO DE AUTORIZACIÓN DE PROPIEDAD DE CLIENTE EN ÓRDENES
// =============================================================================

model ClientOwnershipAuthRequest {
  id            String            @id @default(uuid())
  orderId       String            @map("order_id")
  requestedById String            @map("requested_by_id")
  advisorId     String            @map("advisor_id")
  reason        String?
  status        EditRequestStatus @default(PENDING)
  reviewedById  String?           @map("reviewed_by_id")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNotes   String?           @map("review_notes")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("RequestedClientOwnershipAuthRequests", fields: [requestedById], references: [id])
  advisor     User  @relation("AdvisedClientOwnershipAuthRequests", fields: [advisorId], references: [id])
  reviewedBy  User? @relation("ReviewedClientOwnershipAuthRequests", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([requestedById])
  @@index([advisorId])
  @@index([status])
  @@map("client_ownership_auth_requests")
}

// =============================================================================
// MÓDULO DE INFORMACIÓN DE LA COMPAÑÍA
// =============================================================================
model Company {
  id                  String   @id @default(uuid())
  name                String
  logoLightId         String?  @map("logo_light_id")
  logoDarkId          String?  @map("logo_dark_id")
  description         String?
  phone               String?
  mobilePhone         String?  @map("mobile_phone")
  email               String?
  website             String?
  address             String?
  nit                 String?
  legalRepresentative String?  @map("legal_representative")
  foundedYear         Int?     @map("founded_year")
  taxRegime           String?  @map("tax_regime")
  bankName            String?  @map("bank_name")
  bankAccountNumber   String?  @map("bank_account_number")
  bankAccountType     String?  @map("bank_account_type")
